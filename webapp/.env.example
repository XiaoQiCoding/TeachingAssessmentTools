# 复制为 .env.local 后填写。不要把真实密钥提交到 Git。
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_API_BASE=https://api.minimaxi.com/v1
MINIMAX_ANTHROPIC_BASE=https://api.minimaxi.com/anthropic/v1

# 音轨转写使用同一 MiniMax 密钥；账号需有语音识别权限。
MINIMAX_ASR_MODEL=asr-1.0
# 可选：使用自行安装的 FFmpeg，缺省使用 ffmpeg-static。
# FFMPEG_PATH=
