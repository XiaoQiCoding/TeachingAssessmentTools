# 复制为 .env.local 后填写。不要把真实密钥提交到 Git。
DEFAULT_AI_MODEL=qwen3.8-max
QWEN_API_KEY=
# 正式网站服务使用按量付费 Key；也可替换为相应业务空间的专属地址。
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可在界面切回 MiniMax，两家密钥分别配置。
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_API_BASE=https://api.minimaxi.com/v1
MINIMAX_ANTHROPIC_BASE=https://api.minimaxi.com/anthropic/v1

# 音轨转写使用同一 MiniMax 密钥；账号需有语音识别权限。
MINIMAX_ASR_MODEL=asr-1.0
# 可选：使用自行安装的 FFmpeg，缺省使用 ffmpeg-static。
# FFMPEG_PATH=

# 日志目录，缺省为项目根目录 outputs/logs；容器可指定持久卷目录。
# DIAGNOSTICS_DIR=/data/evaluation-logs
